# Required by the API server and Prisma CLI
DATABASE_URL=postgresql://postgres:password@localhost:5432/certify?schema=public

# Required by the API server. Generate unique random values; never use these labels as values.
JWT_SECRET=
SESSION_SECRET=

# Optional runtime settings
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_MAX_SIZE_MB=20
API_KEY=

# Cloudinary is used by the current upload pipeline.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
