<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Certificate Result — Certify</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0d0f14; color: #e8eaf0; min-height: 100vh; }

    header { display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 60px; background: #13161d; border-bottom: 1px solid #1e222d; }
    .brand { font-weight: 700; font-size: 1.1rem; color: #c8f04d; }
    nav a { color: #6b7280; text-decoration: none; margin-left: 1.5rem; font-size: .9rem; }
    nav a:hover { color: #e8eaf0; }
    nav a.active { color: #c8f04d; }

    main { max-width: 820px; margin: 3rem auto; padding: 0 1.5rem; }
    h1 { font-size: 2rem; font-weight: 700; letter-spacing: -.02em; margin-bottom: 1.5rem; }

    .ssr-badge { display: inline-flex; align-items: center; gap: .5rem; font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #c8f04d; background: rgba(200,240,77,.08); border: 1px solid rgba(200,240,77,.2); border-radius: 20px; padding: .3rem 1rem; margin-bottom: 2rem; }
    .pulse { width: 7px; height: 7px; border-radius: 50%; background: #c8f04d; animation: pulse 1.8s ease infinite; }
    @keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.3; transform:scale(.6); } }

    .card { background: #13161d; border: 1px solid #1e222d; border-radius: 12px; overflow: hidden; }
    .status { display: flex; align-items: center; gap: .75rem; padding: 1rem 1.5rem; font-weight: 700; font-size: 1rem; border-bottom: 1px solid #1e222d; }
    .status.valid   { background: rgba(200,240,77,.08); color: #c8f04d; }
    .status.invalid { background: rgba(255,79,79,.08);  color: #ff4f4f; }

    .fields { display: grid; grid-template-columns: 1fr 1fr; }
    .field { padding: 1.1rem 1.5rem; border-bottom: 1px solid #1e222d; }
    .field:nth-child(odd) { border-right: 1px solid #1e222d; }
    .field-label { font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #6b7280; margin-bottom: .35rem; }
    .field-value { font-size: .95rem; color: #e8eaf0; }
    .field-value.mono { font-family: monospace; font-size: .82rem; color: #a5b4fc; }

    .meta { display: flex; justify-content: space-between; align-items: center; padding: .85rem 1.5rem; font-size: .75rem; color: #6b7280; border-top: 1px solid #1e222d; }

    .empty { text-align: center; padding: 4rem 2rem; }
    .empty-icon { font-size: 2.5rem; margin-bottom: 1rem; opacity: .4; }
    .empty h2 { font-size: 1.1rem; margin-bottom: .5rem; }
    .empty p  { font-size: .875rem; color: #6b7280; }
    .btn { display: inline-block; margin-top: 1.5rem; padding: .6rem 1.4rem; border-radius: 8px; background: #c8f04d; color: #0d0f14; font-weight: 600; font-size: .875rem; text-decoration: none; }
  </style>
</head>
<body>

  <header>
    <span class="brand">✦ Certify</span>
    <nav>
      <a href="/">Home</a>
      <a href="/upload">Upload</a>
      <a href="/view-result" class="active">Result</a>
    </nav>
  </header>

  <main>
    <a href="/" style="position:absolute; top:24px; left:24px; display:inline-flex; align-items:center; gap:0.5rem; text-decoration:none; background:#c8f04d; color:#0d0f14; border-radius:999px; padding:0.8rem 1rem; font-weight:700; box-shadow:0 14px 24px rgba(200,240,77,0.2); z-index:10;">
      <span style="font-size:1rem;">←</span>
      <span>Back to Home</span>
    </a>

    <h1>Certificate Result</h1>

    <div class="ssr-badge">
      <span class="pulse"></span>
      Server-Side Rendered &middot; Express + EJS &middot; <%= renderTime %>
    </div>

    <% if (typeof certificate !== 'undefined' && certificate) { %>

      <div class="card">
        <% const isValid = certificate.status === 'valid'; %>
        <div class="status <%= isValid ? 'valid' : 'invalid' %>">
          <%= isValid ? '✅ Certificate is VALID' : '❌ Certificate is INVALID or REVOKED' %>
        </div>

        <div class="fields">
          <div class="field">
            <div class="field-label">Certificate ID</div>
            <div class="field-value mono"><%= certificate.id || certificate._id || '—' %></div>
          </div>
          <div class="field">
            <div class="field-label">Issued To</div>
            <div class="field-value"><%= certificate.issuedTo || '—' %></div>
          </div>
          <div class="field">
            <div class="field-label">Course / Title</div>
            <div class="field-value"><%= certificate.course || certificate.title || '—' %></div>
          </div>
          <div class="field">
            <div class="field-label">Issued By</div>
            <div class="field-value"><%= certificate.issuedBy || '—' %></div>
          </div>
          <div class="field">
            <div class="field-label">Issue Date</div>
            <div class="field-value"><%= certificate.issueDate ? new Date(certificate.issueDate).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) : '—' %></div>
          </div>
          <div class="field">
            <div class="field-label">Expiry Date</div>
            <div class="field-value"><%= certificate.expiryDate ? new Date(certificate.expiryDate).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) : 'No Expiry' %></div>
          </div>
          <% if (certificate.description) { %>
          <div class="field" style="grid-column: 1 / -1; border-right: none;">
            <div class="field-label">Description</div>
            <div class="field-value"><%= certificate.description %></div>
          </div>
          <% } %>
        </div>

        <div class="meta">
          <span>Rendered at: <strong><%= renderTime %></strong></span>
          <span>Rendered by: <strong>Express + EJS (SSR)</strong></span>
        </div>
      </div>

    <% } else { %>

      <div class="card">
        <div class="empty">
          <div class="empty-icon">📄</div>
          <h2>No Certificate Found</h2>
          <p>Pass a certificate ID as <code style="color:#a5b4fc">?id=...</code> in the URL to verify.</p>
          <a href="/upload" class="btn">Go to Upload</a>
        </div>
      </div>

    <% } %>
  </main>

</body>
</html>
