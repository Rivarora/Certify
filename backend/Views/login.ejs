<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login</title>
  <style>
    body {
      margin: 0;
      position: relative;
      font-family: sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f8f7ff 0%, #ede9ff 30%, #fdf4ff 55%, #fff8f0 80%, #fff 100%);
    }

    .card {
      background: white;
      border-radius: 20px;
      padding: 2.5rem;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 20px 60px rgba(108,99,255,0.12), 0 4px 20px rgba(0,0,0,0.06);
    }

    h2 { margin-bottom: 0.3rem; }
    p { color: #6b7280; }

    .field { margin-bottom: 1rem; }
    label { font-size: 0.85rem; font-weight: 600; }

    input {
      width: 100%;
      padding: 0.7rem;
      border-radius: 10px;
      border: 1px solid #ddd;
    }

    button {
      width: 100%;
      padding: 0.8rem;
      background: linear-gradient(135deg, #6c63ff, #a855f7);
      color: white;
      border: none;
      border-radius: 10px;
      font-weight: bold;
      cursor: pointer;
    }

    .error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #dc2626;
      padding: 0.6rem;
      border-radius: 8px;
      margin-bottom: 1rem;
    }

    a {
      color: #6c63ff;
      text-decoration: none;
      font-weight: bold;
    }
  </style>
</head>
<body>

  <div class="card">
    <h2>Welcome back</h2>
    <p>Sign in to your account</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/api/login-form">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" required />
      </div>

      <div class="field">
        <label>Password</label>
        <input type="password" name="password" required />
      </div>

      <button type="submit">
        <% if (loading) { %>
          Signing in...
        <% } else { %>
          Sign In →
        <% } %>
      </button>
    </form>

    <p style="text-align:center; margin-top: 1rem;">
      Don't have an account?
      <a href="/api/register">Create one</a>
    </p>
  </div>

</body>
</html>